#!/usr/bin/env bash
set -Eeuo pipefail

: "${AGENT_SCREEN_SSH_HOST:?Set AGENT_SCREEN_SSH_HOST (for example screens.example.com)}"
: "${AGENT_SCREEN_CUA_SCREEN:?Set AGENT_SCREEN_CUA_SCREEN between 1 and 4}"

case "$AGENT_SCREEN_CUA_SCREEN" in
  1|2|3|4) ;;
  *) printf 'AGENT_SCREEN_CUA_SCREEN must be between 1 and 4\n' >&2; exit 2 ;;
esac

ssh_bin="${AGENT_SCREEN_SSH_BIN:-/usr/bin/ssh}"
ssh_user="${AGENT_SCREEN_SSH_USER:-root}"
ssh_port="${AGENT_SCREEN_SSH_PORT:-22}"
identity="${AGENT_SCREEN_SSH_IDENTITY:-}"
endpoint="${AGENT_SCREEN_REMOTE_ENDPOINT:-/usr/local/sbin/cua-driver-remote-endpoint}"
local_wrapper="${AGENT_SCREEN_LOCAL_WRAPPER:-$0}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ssh_args=(
  -p "$ssh_port"
  -o BatchMode=yes
  -o IdentitiesOnly=yes
  -o StrictHostKeyChecking=yes
)
if [[ -n "$identity" ]]; then
  ssh_args+=(-i "$identity")
fi

printf -v remote_command '%q ' "$endpoint" "$AGENT_SCREEN_CUA_SCREEN" "$@"

if [[ "${1:-}" == manifest ]]; then
  "$ssh_bin" "${ssh_args[@]}" "${ssh_user}@${AGENT_SCREEN_SSH_HOST}" "$remote_command" \
    | python3 "$script_dir/rewrite_cua_manifest.py" "$local_wrapper"
else
  exec "$ssh_bin" "${ssh_args[@]}" "${ssh_user}@${AGENT_SCREEN_SSH_HOST}" "$remote_command"
fi
