#!/usr/bin/env python3
import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/opt/agent-screen")
from agent_screen.runtime import ScreenSpec, viewer_url

HOST = os.environ.get("AGENT_SCREEN_HOST", "screens.example.com")


def run(command, check=True):
    return subprocess.run(command, check=check, text=True)


def main():
    parser = argparse.ArgumentParser(prog="agent-screen")
    parser.add_argument("action", choices=["start", "stop", "restart", "status", "browser", "screenshot", "url"])
    parser.add_argument("screen_id", type=int)
    parser.add_argument("output", nargs="?")
    args = parser.parse_args()
    spec = ScreenSpec.from_id(args.screen_id)
    desktop = f"agent-screen@{args.screen_id}.service"
    browser = f"agent-screen-chrome@{args.screen_id}.service"

    if args.action in {"start", "stop", "restart"}:
        run(["systemctl", args.action, desktop])
    elif args.action == "browser":
        run(["systemctl", "start", browser])
    elif args.action == "status":
        for unit in (desktop, browser):
            result = subprocess.run(["systemctl", "is-active", unit], text=True, capture_output=True)
            print(f"{unit}={result.stdout.strip() or 'inactive'}")
        x = subprocess.run(["runuser", "-u", "agent", "--", "env", f"DISPLAY={spec.display}", "xdpyinfo"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"display_ready={'yes' if x.returncode == 0 else 'no'}")
        cdp = subprocess.run(["curl", "-fsS", "--max-time", "2", f"http://127.0.0.1:{spec.cdp_port}/json/version"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"chrome_cdp={'ready' if cdp.returncode == 0 else 'stopped'}")
        print(f"viewer={viewer_url(HOST, args.screen_id)}")
    elif args.action == "screenshot":
        output = Path(args.output or f"/tmp/agent-screen-{args.screen_id}.png").resolve()
        output.parent.mkdir(parents=True, exist_ok=True)
        run(["runuser", "-u", "agent", "--", "env", f"DISPLAY={spec.display}", "scrot", "-o", str(output)])
        print(output)
    elif args.action == "url":
        print(viewer_url(HOST, args.screen_id))


if __name__ == "__main__":
    main()
